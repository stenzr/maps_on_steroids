# Server-side Google key. Enable ONLY: Routes API, Places API (New).
# Restrict it by API (and by IP if you host on a fixed egress IP). Never put this key in the app.
GOOGLE_MAPS_API_KEY=

# Shared secret the app sends in the X-App-Secret header. Generate with: openssl rand -hex 32
PROXY_SHARED_SECRET=

PORT=8787
# Requests per minute per client IP
RATE_LIMIT_PER_MINUTE=120
