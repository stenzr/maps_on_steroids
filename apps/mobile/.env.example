# Maps SDK for Android key. In Google Cloud restrict it to "Android apps" with
# package com.roadtripcompanion.app + your debug/release SHA-1, and to the "Maps SDK for Android" API only.
ANDROID_MAPS_API_KEY=

# Where the proxy runs. On a phone over USB/Wi-Fi during dev use your laptop's LAN IP, e.g. http://192.168.1.20:8787
EXPO_PUBLIC_PROXY_URL=http://192.168.1.20:8787
# Must match PROXY_SHARED_SECRET in apps/proxy/.env. It ships inside the app, so it only keeps strangers
# off the proxy; it is not a real secret.
EXPO_PUBLIC_PROXY_SECRET=
